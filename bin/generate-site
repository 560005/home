#!/usr/bin/env bb
;;; Site generator for 560005.town - pulls data from Cloudflare D1 and creates Zola pages
;;; Usage: bb bin/generate-site
;;; Requires env: CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN (D1 read),
;;;               optionally D1_DATABASE_ID (defaults to the 560005-town DB).

(require '[babashka.http-client :as http]
         '[babashka.fs :as fs]
         '[cheshire.core :as json]
         '[clojure.string :as str])

;; Configuration
(def account-id  (System/getenv "CLOUDFLARE_ACCOUNT_ID"))
(def database-id (or (System/getenv "D1_DATABASE_ID") "9314d0ff-d359-4152-866f-ea8747b8208b"))
(def api-token   (System/getenv "CLOUDFLARE_API_TOKEN"))
(def content-dir "content")

(when (or (str/blank? account-id) (str/blank? api-token))
  (println "FATAL: CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN must be set")
  (System/exit 1))

(def d1-url
  (str "https://api.cloudflare.com/client/v4/accounts/" account-id
       "/d1/database/" database-id "/query"))

;; --- Cloudflare D1 helpers ---
;; D1's REST API binds positional `?` placeholders to a params array, so
;; parameterised queries below use `?` rather than Datasette's `:named` params.

(defn query
  "Execute SQL against Cloudflare D1, returns a vector of row maps.
  Throws on transport/HTTP failure so a broken run fails the build loudly
  instead of silently emitting an empty site."
  [sql & [params]]
  (let [resp (http/post d1-url
                        {:headers {"Authorization" (str "Bearer " api-token)
                                   "Content-Type" "application/json"}
                         :body    (json/generate-string {:sql sql :params (vec params)})
                         :throw   false})
        body (json/parse-string (:body resp) true)]
    (when-not (:success body)
      (println "D1 query failed (HTTP" (:status resp) "):" (pr-str (:errors body)))
      (println "  SQL:" sql)
      (System/exit 1))
    (-> body :result first :results)))

(defn slug [s]
  (-> s str/lower-case str/trim
      (str/replace #"[^a-z0-9\s-]" "")
      (str/replace #"\s+" "-")))

(defn truncate [s n]
  (when s (if (> (count s) n) (str (subs s 0 n) "...") s)))

(defn parse-tags [tags-str]
  (when tags-str
    (try (vec (json/parse-string tags-str))
         (catch Exception _ []))))

;; --- Data fetching ---

(defn fetch-categories-with-counts []
  (query "SELECT c.id, c.slug, c.name, COUNT(l.id) as listing_count
          FROM categories c
          LEFT JOIN listings l ON c.id = l.category_id
          GROUP BY c.id, c.slug, c.name
          ORDER BY c.name"))

(defn fetch-listings-for-category [cat-slug]
  (query "SELECT l.*, c.slug as category_slug, c.name as category_name
          FROM listings l
          JOIN categories c ON l.category_id = c.id
          WHERE c.slug = ?
          ORDER BY l.name"
         [cat-slug]))

(defn fetch-all-tags []
  (query "SELECT json_each.value as tag, COUNT(*) as listing_count
          FROM listings, json_each(listings.tags)
          WHERE listings.tags IS NOT NULL
          GROUP BY json_each.value
          ORDER BY listing_count DESC"))

(defn fetch-listings-by-tag [tag]
  (query "SELECT l.*, c.slug as category_slug, c.name as category_name
          FROM listings l
          LEFT JOIN categories c ON l.category_id = c.id
          WHERE l.tags IS NOT NULL
            AND EXISTS (SELECT 1 FROM json_each(l.tags) WHERE json_each.value = ?)
          ORDER BY l.name"
         [tag]))

;; --- TOML frontmatter ---

(defn toml-value [v]
  (cond
    (string? v)  (str "\"" (str/replace v #"\"" "\\\\\"") "\"")
    (boolean? v) (str v)
    (number? v)  (str v)
    (vector? v)  (json/generate-string v)
    :else        (str "\"" v "\"")))

(defn frontmatter [m & [extra]]
  (str "+++\n"
       (->> m (map (fn [[k v]] (str (name k) " = " (toml-value v)))) (str/join "\n"))
       (when extra
         (str "\n\n[extra]\n"
              (->> extra (map (fn [[k v]] (str (name k) " = " (toml-value v)))) (str/join "\n"))))
       "\n+++\n"))

;; --- Page generators ---

(defn generate-listing-page [cat-slug listing]
  (let [listing-slug (slug (:name listing))
        dir (str content-dir "/c/" cat-slug "/" (:id listing) "-" listing-slug)
        tags (parse-tags (:tags listing))
        fm (frontmatter
            {:title       (str (:name listing) " - 560005.town")
             :description (truncate (or (:description listing) "") 160)
             :template    "listing.html"}
            (merge {:listing_name  (:name listing)
                    :category_slug cat-slug
                    :listing_description (or (:description listing) "")
                    :phone         (or (:phone listing) "")
                    :address       (or (:address listing) "")
                    :tags          (or tags [])
                    :verified_by   (or (:verified_by listing) "")
                    :created_at    (or (:created_at listing) "")}
                   (when (number? (:latitude listing))
                     {:latitude  (:latitude listing)
                      :longitude (:longitude listing)})
                   (when (seq (str (:geohash listing)))
                     {:geohash (str (:geohash listing))})
                   (when (seq (str (:maps_link listing)))
                     {:maps_link (str (:maps_link listing))})))]
    (fs/create-dirs dir)
    (spit (str dir "/index.md") fm)))

(defn generate-category-page [cat]
  (let [cat-slug (:slug cat)
        cat-name (:name cat)
        listings (fetch-listings-for-category cat-slug)
        dir (str content-dir "/c/" cat-slug)
        fm (frontmatter
            {:title       (str cat-name " - 560005.town")
             :description (str "All " (str/lower-case cat-name) " listings in East Bangalore")
             :template    "category.html"
             :transparent true}
            {:category_name cat-name
             :category_slug cat-slug})]
    (println "  category:" cat-name (str "(" (count listings) " listings)"))
    (fs/create-dirs dir)
    (spit (str dir "/_index.md")
          (str fm "\n# " cat-name "\n\n"
               (if (seq listings)
                 (str "*" (count listings) " listings*\n\n"
                      (->> listings
                           (map (fn [l]
                                  (str "## [" (:name l) "](" (:id l) "-" (slug (:name l)) "/)\n"
                                       (when (:description l) (str (truncate (:description l) 200) "\n"))
                                       (when (seq (:phone l)) (str "📞 " (:phone l) "  "))
                                       (when (seq (:address l)) (str "📍 " (:address l)))
                                       "\n\n")))
                           (str/join "")))
                 "*No listings found in this category.*\n")))
    (doseq [l listings]
      (generate-listing-page cat-slug l))))

(defn generate-tag-page [tag]
  (let [tag-name (:tag tag)
        tag-slug (slug tag-name)
        listings (fetch-listings-by-tag tag-name)
        dir (str content-dir "/t/" tag-slug)
        fm (frontmatter
            {:title       (str "#" tag-name " - 560005.town")
             :description (str "All listings tagged with " tag-name)
             :template    "tag.html"}
            {:tag_name tag-name
             :tag_slug tag-slug})]
    (println "  tag:" tag-name (str "(" (count listings) " listings)"))
    (fs/create-dirs dir)
    (spit (str dir "/index.md")
          (str fm "\n<h1>#" tag-name "</h1>\n"
               "<p class=\"muted\">" (count listings) " listing" (when (not= 1 (count listings)) "s") "</p>\n\n"
               (if (seq listings)
                 (->> listings
                      (map (fn [l]
                             (let [url (str "/c/" (:category_slug l) "/" (:id l) "-" (slug (:name l)) "/")
                                   tags (parse-tags (:tags l))]
                               (str "<article class=\"listing-card\">\n"
                                    "<h2><a href=\"" url "\">" (:name l) "</a></h2>\n"
                                    (when (seq (str (:verified_by l)))
                                      (str "<p class=\"listing-verified\">&#10003; Verified by " (:verified_by l) "</p>\n"))
                                    (when (:description l)
                                      (str "<p>" (truncate (:description l) 200) "</p>\n"))
                                    (when (seq (:phone l))
                                      (str "<p class=\"listing-meta\">&#128222; <a href=\"tel:" (:phone l) "\">" (:phone l) "</a></p>\n"))
                                    (when (seq tags)
                                      (str "<p>"
                                           (str/join " " (map (fn [t] (str "<a href=\"/t/" (slug t) "/\" class=\"tag\">" t "</a>")) tags))
                                           "</p>\n"))
                                    "</article>\n"))))
                      (str/join ""))
                 "<p>No listings found with this tag.</p>\n")))))

(defn generate-index-page [categories tags]
  (let [cats-toml (->> categories
                       (map (fn [c] (str "{name = " (toml-value (:name c))
                                         ", slug = " (toml-value (:slug c))
                                         ", count = " (:listing_count c) "}")))
                       (str/join ", "))
        tags-toml (->> tags
                       (take 50)
                       (map (fn [t] (str "{name = " (toml-value (:tag t))
                                         ", slug = " (toml-value (slug (:tag t))) "}")))
                       (str/join ", "))
        fm (str "+++\n"
                "title = \"560005.town - East Bangalore Directory\"\n"
                "description = \"Community-maintained listings of local services, people, and places\"\n"
                "template = \"index.html\"\n"
                "\n[extra]\n"
                "categories = [" cats-toml "]\n"
                "tags = [" tags-toml "]\n"
                "+++\n")]
    (spit (str content-dir "/_index.md") fm)))

;; --- Main ---

(defn generate-all []
  (println "🚀 Generating site from Cloudflare D1" database-id)

  ;; Clean and recreate generated content dirs (preserve static pages like about.md)
  (doseq [d ["c" "t"]]
    (let [path (str content-dir "/" d)]
      (when (fs/exists? path) (fs/delete-tree path))
      (fs/create-dirs path)))

  ;; Parent sections so child pages are not orphans (required for search indexing)
  (spit (str content-dir "/c/_index.md")
        (frontmatter {:title "Categories" :transparent true :render false :in_search_index false}))
  (spit (str content-dir "/t/_index.md")
        (frontmatter {:title "Tags" :transparent true :render false :in_search_index false}))

  (let [categories (fetch-categories-with-counts)
        tags       (fetch-all-tags)]

    (println "Found" (count categories) "categories," (count tags) "tags")

    ;; Guard against publishing an empty/broken site if the data source is
    ;; unreachable or returns nothing (this is what broke the site once before).
    (when (empty? categories)
      (println "FATAL: no categories returned from D1 - refusing to build an empty site")
      (System/exit 1))

    (generate-index-page categories tags)
    (println "✓ Index page")

    (doseq [cat categories] (generate-category-page cat))
    (println "✓ Category pages")

    (doseq [tag tags] (generate-tag-page tag))
    (println "✓ Tag pages")

    (println "✅ Done! Run 'zola serve' to preview.")))

(generate-all)
